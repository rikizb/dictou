# ===========================
# BASE DE DONNÉES - Neon
# ===========================
# Récupère ces URLs dans le dashboard Neon (Settings > Connection Details)
DATABASE_URL="postgresql://user:password@host/dicteo?sslmode=require"

# ===========================
# AUTHENTIFICATION - Clerk
# ===========================
# Crée un compte sur clerk.com, puis un projet "Dicteo"
# Les clés sont dans ton dashboard Clerk (API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# URLs de redirection Clerk (ne pas changer)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ===========================
# IA - Anthropic Claude
# ===========================
# Crée un compte sur console.anthropic.com et génère une clé API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
